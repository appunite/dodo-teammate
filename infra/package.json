{
  "name": "dodo-teammate-infra",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "audit": "bun audit --audit-level=high",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run audit"
  },
  "dependencies": {
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/bun": "1.3.14",
    "@types/node": "26.1.2",
    "typescript": "7.0.2"
  }
}
